#!/usr/bin/make -f

DESTDIR     := $(CURDIR)/debian/fiwu
PY_PACKAGES := $(DESTDIR)/usr/lib/python3/dist-packages

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_test:

override_dh_python3:
	dh_python3 --no-guessing-deps --depends=python3 -V 3.10-

override_dh_installsystemd:
	dh_installsystemd --no-start

override_dh_auto_install:
	dh_auto_install

	# Stage raw source archive for host-side compilation during postinst
	install -d $(DESTDIR)/usr/share/fiwu/netfilterqueue_src
	cp debian/netfilterqueue/NetfilterQueue-*.tar.gz $(DESTDIR)/usr/share/fiwu/netfilterqueue_src/

	# Configuration & Service Files
	install -D -m 664 src/fiwu/config.json $(DESTDIR)/etc/fiwu/config.json
	install -D -m 644 fiwu.service $(DESTDIR)/usr/lib/systemd/system/fiwu.service
	install -D -m 0440 debian/fiwu-toggle.sudoers $(DESTDIR)/etc/sudoers.d/fiwu-toggle

	# AppArmor Profile (if present)
	if [ -f fiwu-apparmor-profile ]; then \
		install -D -m 644 fiwu-apparmor-profile $(DESTDIR)/etc/apparmor.d/fiwu ; \
	fi

	# GNOME Shell Extension
	mkdir -p $(DESTDIR)/usr/share/gnome-shell/extensions/fiwu-toggle@rnd.smile.fr
	cp -r src/fiwu/gui/extension/. $(DESTDIR)/usr/share/gnome-shell/extensions/fiwu-toggle@rnd.smile.fr/

override_dh_fixperms:
	dh_fixperms
	chmod 664 $(DESTDIR)/etc/fiwu/config.json
	chmod 0440 $(DESTDIR)/etc/sudoers.d/fiwu-toggle
	chmod -R a+r $(DESTDIR)/usr/share/gnome-shell/extensions/